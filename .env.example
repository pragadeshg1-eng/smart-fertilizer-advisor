# Environment Configuration Template for Vayal Fertilizer Advisor
# Copy this file to .env or set environment variables in your terminal/IDE.
# Never commit actual credentials to version control.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fertilizer_advisor_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SERVER_PORT=8080
